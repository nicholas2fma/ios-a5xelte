diff --git a/osfmk/arm64/caches_asm.s b/osfmk/arm64/caches_asm.s
index e777b77..efb57f6 100644
--- a/osfmk/arm64/caches_asm.s
+++ b/osfmk/arm64/caches_asm.s
@@ -262,7 +262,11 @@ LEXT(CleanPoU_DcacheRegion)
 	lsr		x4, x4, #MMU_CLINE					// Set cache line counter
 	dmb		sy
 L_cpudr_loop:
+#if defined(ARM64_BOARD_CONFIG_ZEROFLTE)
+	dc		civac, x3							// A53 r0p2 errata 826319, 827319, 824069
+#else
 	dc		cvau, x3							// Clean dcache line to PoU 
+#endif
 	add		x3, x3, #(1<<MMU_CLINE)				// Get next cache aligned addr
 	subs	x4, x4, #1							// Decrementer cache line counter
 	b.pl	L_cpudr_loop						// Loop in counter not null
@@ -293,7 +297,11 @@ L_cpcdr_loop:
 	// Apple hardware.
 	dc		civac, x0							// Clean & Invalidate dcache line to PoC
 #else /* defined(APPLE_ARM64_ARCH_FAMILY) */
+#if defined(ARM64_BOARD_CONFIG_ZEROFLTE)
+	dc		civac, x0							// A53 r0p2 errata 826319, 827319, 824069
+#else
 	dc		cvac, x0 							// Clean dcache line to PoC
+#endif
 #endif /* defined(APPLE_ARM64_ARCH_FAMILY) */
 	add		x0, x0, #(1<<CLINE_FLUSH_STRIDE)	// Get next cache aligned addr
 	subs	x1, x1, #1							// Decrementer cache line counter
